# ==============================================================
# MEDICARE - ENVIRONMENT CONFIGURATION TEMPLATE
# Instructions:
# 1. On Localhost: Copy this file as ".env" in the project root.
# 2. On Render: Add these variables under "Environment" in your Render Dashboard.
# ==============================================================

# 1. DATABASE CONFIGURATION (PostgreSQL)
# Render provides DATABASE_URL automatically when you attach a PostgreSQL instance:
DATABASE_URL=postgresql://medicare_user:YOUR_POSTGRES_PASSWORD@YOUR_POSTGRES_HOST:5432/medicare_db

# Alternative individual database credentials (used if DATABASE_URL is not set):
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=medicare
DB_USER=postgres
DB_PASSWORD=YOUR_DB_PASSWORD

# 2. FLASK SESSION SECURITY
SECRET_KEY=generate_a_random_32_character_secret_key_here
FLASK_ENV=production
PORT=5000
HOST=0.0.0.0

# 3. SMTP EMAIL DELIVERY (For Doctor & Authority MFA Verification Codes)
# Example for Gmail: smtp.gmail.com, Port: 587, use App Password (not normal password)
# Example for SendGrid: smtp.sendgrid.net, Port: 587, User: apikey
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_hospital_notifications@gmail.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_USE_TLS=true
MAIL_DEFAULT_SENDER=Medicare Security <no-reply@medicare.io>

# Optional: Set to true during local dev testing if you do not have an active SMTP server yet
# (Outputs codes safely to server terminal for instant verification)
SMTP_DEV_MODE=true
