# ==============================================================
# MEDICARE HEALTHCARE PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================
# In production on Render.com, set these variables in your Web Service "Environment" tab.
# For local testing, copy this file as ".env" in the project root.

# --- 1. APPLICATION & SESSION SECURITY ---
SECRET_KEY=generate_a_cryptographically_random_secret_key_here
FLASK_ENV=production
PORT=5000
HOST=0.0.0.0

# Optional: Dedicated cryptographic salt for one-time access code hashing
CODE_SALT=random_hex_salt_string_2026

# --- 2. MYSQL DATABASE CREDENTIALS (RENDER / CLOUD) ---
# Compatible with Render MySQL, Railway MySQL, Aiven, or AWS RDS
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=medicare
DB_USER=root
DB_PASSWORD=your_secure_mysql_password

# Alternative single-string MySQL URI (if provided by your database provider)
# DATABASE_URL=mysql://user:password@host:3306/medicare

# --- 3. SMTP EMAIL SERVICE CREDENTIALS ---
# Used for delivering short-lived Doctor and Authority Access / Verification Codes.
# Compatible with Gmail SMTP, Brevo, SendGrid, Mailgun, Amazon SES, or custom SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_hospital_notifications_email@gmail.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_USE_TLS=True
SMTP_FROM_EMAIL=noreply@medicare.io

# --- 4. OPTIONAL DOMAIN / URL BINDINGS ---
# RENDER_EXTERNAL_URL=https://your-medicare-app.onrender.com
